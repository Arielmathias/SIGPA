# Copiar a .env y completar. El .env NUNCA se sube al repo.

# --- Acceso al editor de n8n (http://localhost:5678) ---
# No se configura aquí: desde n8n 1.0+ el login es una cuenta owner
# (email + password) que se crea en la UI la primera vez que se entra.

# --- Backend SIGPA (FastAPI) ---
# URL base del backend al que n8n le hace las llamadas REST.
#   Producción:            https://sigpa-34sy.onrender.com
#   Backend local en paralelo (desde el contenedor): http://host.docker.internal:8000
SIGPA_BACKEND_URL=

# Secreto compartido para que el backend valide que la llamada viene de n8n.
# Mismo patrón que X-Cron-Secret en /internal/recordatorio-diario.
# TODO: el nombre del header y el valor final se coordinan con el backend
# cuando se construya el endpoint de rutas (/rutas/planificar).
SIGPA_INTERNAL_SECRET=

# --- OpenRouteService ---
# TODO: pendiente de generar en https://openrouteservice.org (nivel gratuito).
OPENROUTESERVICE_API_KEY=
