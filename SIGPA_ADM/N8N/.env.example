# Copiar a .env y completar. El .env NUNCA se sube al repo.

# --- Acceso al editor de n8n (http://localhost:5678) ---
# No se configura aquí: desde n8n 1.0+ el login es una cuenta owner
# (email + password) que se crea en la UI la primera vez que se entra.

# --- Webhook de rutas (lo llama el backend SIGPA) ---
# Secreto que el backend envía en el header X-Route-Secret al llamar al
# webhook desde POST /rutas/planificar. El workflow debe rechazar cualquier
# llamada que no lo traiga. Mismo valor que N8N_ROUTE_WEBHOOK_SECRET en las
# variables del backend.
SIGPA_ROUTE_WEBHOOK_SECRET=

# --- Depósito (punto de partida de la ruta) ---
# Las coordenadas del depósito viven solo en n8n; el backend no las envía.
DEPOSITO_LATITUD=
DEPOSITO_LONGITUD=

# --- OpenRouteService ---
# TODO: pendiente de generar en https://openrouteservice.org (nivel gratuito).
OPENROUTESERVICE_API_KEY=
